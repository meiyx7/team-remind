/* custom-tab-bar/index.wxss */
/* 结构说明：高度由内容撑开（图标44+文字+内边距），不再固定 100rpx，
   彻底修复安全区设备上图标溢出底栏的问题 */

.tabbar {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  position: relative;
  z-index: 10;
  padding: 12rpx 12rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  /* 字面色兜底在前，变量解析失败也不会透明 */
  background: #ffffff;
  background: var(--bg-primary, #ffffff);
  border-top: 1rpx solid var(--border-light);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  border-radius: var(--radius-full);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: var(--color-brand);
  font-weight: 600;
}

.tabbar-safe {
  background: #ffffff;
  background: var(--bg-primary, #ffffff);
}

/* ---- 液态玻璃风格：悬浮胶囊 TabBar ---- */
/* 底边距含安全区：胶囊整体脱离屏幕下缘，透出页面环境光 */
.tabbar.style-glass {
  margin: 0 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.70);
  border-radius: 52rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.52) 100%);
  backdrop-filter: blur(56rpx) saturate(180%);
  -webkit-backdrop-filter: blur(56rpx) saturate(180%);
  box-shadow:
    0 16rpx 44rpx rgba(15, 23, 42, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.70);
}

/* 暗色玻璃胶囊 */
.tabbar.theme-dark.style-glass {
  background: linear-gradient(180deg, rgba(51, 65, 85, 0.78) 0%, rgba(30, 41, 59, 0.60) 100%);
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow:
    0 16rpx 44rpx rgba(0, 0, 0, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

/* 选中项品牌色药丸底 + 光晕 */
.tabbar.style-glass .tab-item.active {
  background: var(--brand-tint-strong);
  box-shadow: 0 4rpx 16rpx var(--brand-tint-strong);
}

/* 玻璃模式下底部安全条隐藏（间距已并入胶囊外边距） */
.tabbar-safe.style-glass {
  display: none;
}
