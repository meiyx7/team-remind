<!-- pages/home/home.wxml 首页 = 待办（问候+进度+视图切换+统计筛选） -->
<view class="page-container {{themeClass}}">
  <nav-bar title="团队待办"></nav-bar>

  <!-- 消息铃铛（对齐胶囊左侧，带未读角标） -->
  <view class="notif-entry" style="top: {{bellTop}}px; right: {{bellRight}}px;" bindtap="goNotifications">
    <image class="notif-bell" src="{{bellIcon}}" />
    <view wx:if="{{unreadCount > 0}}" class="notif-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
  </view>

  <view class="home-content">
    <!-- 顶部问候卡：日期 + 今日环形进度 -->
    <view class="greeting-card">
      <view class="greeting-row">
        <view class="greeting-main">
          <text class="greeting-text">{{greeting}}，{{userName}}</text>
          <view class="greeting-date-row">
            <text class="greeting-date">{{todayLabel}}</text>
            <view class="sync-chip sync-{{syncState}}" wx:if="{{syncLabel}}">
              <view class="sync-dot"></view>
              <text>{{syncLabel}}</text>
            </view>
          </view>
        </view>
        <view class="today-ring-wrap" wx:if="{{todayStats.total > 0}}">
          <view class="ring-box">
            <image class="ring-svg" src="{{ringUri}}" />
            <text class="ring-num">{{todayStats.rate}}<text class="ring-pct">%</text></text>
          </view>
          <text class="ring-label">{{todayStats.completed}}/{{todayStats.total}} 今日完成</text>
        </view>
      </view>
    </view>

    <!-- 逾期警示条 -->
    <view wx:if="{{overdueCount > 0}}" class="overdue-strip" bindtap="goOverdueFilter" hover-class="card-pressed">
      <view class="overdue-dot"></view>
      <text class="overdue-strip-text">{{overdueCount}} 项待办已逾期</text>
      <text class="overdue-strip-action">去处理 ›</text>
    </view>

    <!-- 时间维度视图切换 -->
    <view class="range-tabs">
      <view
        class="range-tab {{rangeFilter === item.key ? 'active' : ''}}"
        wx:for="{{rangeDefs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onRangeTap"
      >{{item.label}}</view>
    </view>

    <!-- 统计卡：同时作为状态筛选条件 -->
    <view class="stats-grid">
      <view
        class="stat-card stat-{{item.key}} {{statFilter === item.key ? 'active' : ''}}"
        wx:for="{{stats}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onStatTap"
      >
        <text class="stat-count">{{item.key === 'completed' ? item.rate + '%' : item.count}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 搜索框（可折叠） -->
    <view wx:if="{{searchVisible}}" class="home-search">
      <image class="hs-icon" src="{{searchIcon}}" />
      <input
        class="hs-input"
        type="text"
        placeholder="搜索标题..."
        placeholder-class="form-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view wx:if="{{searchKeyword}}" class="hs-clear" bindtap="onClearSearch">
        <image class="hs-clear-icon" src="{{clearIcon}}" />
      </view>
    </view>

    <!-- 当前筛选标识 -->
    <view class="list-header">
      <text class="list-title">{{listTitle}}</text>
      <view class="list-header-right">
        <text class="list-count">{{todos.length}} 项</text>
        <image class="list-search-btn" src="{{tplIcon}}" bindtap="goTemplates" />
        <image class="list-search-btn" src="{{searchIcon}}" bindtap="toggleSearch" />
      </view>
    </view>

    <!-- 待办列表 -->
    <view wx:if="{{todos.length > 0}}" class="todo-list">
      <todo-card
        wx:for="{{todos}}"
        wx:key="id"
        todo="{{item}}"
        show-check="{{true}}"
        show-team="{{true}}"
        bind:toggle="onToggleTodo"
        bind:tap="onTapTodo"
        bind:longpress="onTodoLongPress"
      />
    </view>

    <!-- 空态 -->
    <empty-state
      wx:else
      text="{{emptyText}}"
      hint="{{emptyHint}}"
      action-text="{{emptyAction}}"
      bind:action="goCreateTodo"
    />
  </view>

  <!-- FAB -->
  <view class="fab" bindtap="goCreateTodo">
    <image class="fab-icon" src="{{plusIcon}}" />
  </view>
</view>
