<!-- pages/team-detail/team-detail.wxml -->
<view class="page-container {{themeClass}}">
  <nav-bar title="团队详情" show-back="{{true}}"></nav-bar>

  <!-- 团队不存在 / 空态 -->
  <state-view
    wx:if="{{!team}}"
    state="empty"
    title="团队不存在"
    desc="该团队可能已被删除，或链接已失效"
  />

  <view wx:else class="team-detail-content">
    <!-- 团队头部卡 -->
    <view class="team-header-card">
      <view class="header-row">
        <avatar text="{{team.avatarChar}}" color="{{team.avatarColor}}" size="lg" />
        <view class="team-meta">
          <text class="team-name">{{team.name}}</text>
          <text class="team-desc">{{team.description}}</text>
        </view>
        <!-- 周报入口 -->
        <view class="report-btn" bindtap="goReport">周报</view>
      </view>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num">{{team.memberCount}}</text>
          <text class="stat-label">成员</text>
        </view>
        <view class="stat-dot"></view>
        <view class="stat-item">
          <text class="stat-num text-brand">{{todos.length}}</text>
          <text class="stat-label">待办</text>
        </view>
        <view class="stat-dot"></view>
        <view class="stat-item">
          <text class="stat-num">{{completedCount}}</text>
          <text class="stat-label">已完成</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="switchTab">
        <text>成员</text>
      </view>
      <view class="tab-item {{activeTab === 'todos' ? 'active' : ''}}" data-tab="todos" bindtap="switchTab">
        <text>待办</text>
      </view>
      <view class="tab-item {{activeTab === 'events' ? 'active' : ''}}" data-tab="events" bindtap="switchTab">
        <text>动态</text>
      </view>
    </view>

    <!-- 成员列表 -->
    <view wx:if="{{activeTab === 'members'}}" class="members-list">
      <view
        class="member-row"
        wx:for="{{members}}"
        wx:key="id"
        hover-class="{{item.canManage ? 'card-pressed' : ''}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-manageable="{{item.canManage}}"
        bindtap="onMemberTap"
      >
        <avatar text="{{item.avatarChar}}" color="{{item.avatarColor}}" size="sm" />
        <text class="member-name">{{item.name}}</text>
        <view class="member-badge {{item.role}}">{{item.roleLabel}}</view>
        <view
          wx:if="{{item.canRemove && !item.canManage}}"
          class="remove-member-btn"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          catchtap="onRemoveMember"
        >移除</view>
      </view>

      <!-- 邀请 / 退出 / 归档 / 解散 -->
      <view class="invite-btn" bindtap="onInvite">
        <image class="invite-icon" src="{{plusIcon}}" />
        <text>邀请成员</text>
      </view>

      <view class="danger-actions">
        <view wx:if="{{isCreator}}" class="ghost-link" bindtap="onToggleArchive">{{team.archived ? '取消归档团队' : '归档团队'}}</view>
        <view wx:if="{{isCreator}}" class="ghost-link danger" bindtap="onDissolveTeam">解散团队</view>
        <view wx:if="{{isMember && !isCreator}}" class="ghost-link danger" bindtap="onQuitTeam">退出团队</view>
      </view>
    </view>

    <!-- 待办列表 -->
    <view wx:if="{{activeTab === 'todos'}}" class="todos-pane">
      <filter-tabs filters="{{todoFilters}}" active="{{todoFilter}}" bind:change="switchTodoFilter" />

      <view wx:if="{{filteredTodos.length > 0}}" class="todo-cards">
        <todo-card
          wx:for="{{filteredTodos}}"
          wx:key="id"
          todo="{{item}}"
          show-team="{{false}}"
          bind:toggle="onToggleTodo"
          bind:tap="onTapTodo"
          bind:longpress="onTodoLongPress"
        />
      </view>
      <empty-state wx:else text="暂无待办" />
    </view>

    <!-- 动态流 -->
    <view wx:if="{{activeTab === 'events'}}" class="events-pane">
      <view wx:if="{{events.length > 0}}" class="event-list">
        <view class="event-item" wx:for="{{events}}" wx:key="id">
          <avatar text="{{item.actorAvatarChar}}" color="{{item.actorAvatarColor}}" size="sm" />
          <view class="event-body">
            <view class="event-line">
              <text class="event-actor">{{item.actorName}}</text>
              <text class="event-action event-{{item.type}}">{{item.content}}</text>
            </view>
            <text class="event-time">{{item.timeLabel}}</text>
          </view>
          <text
            wx:if="{{item.todoId}}"
            class="event-link"
            data-id="{{item.todoId}}"
            catchtap="onTapTodoFromEvent"
          >查看</text>
        </view>
      </view>
      <empty-state wx:else text="暂无动态" hint="创建、完成、认领、评论都会记录在这里" />
    </view>
  </view>
</view>
