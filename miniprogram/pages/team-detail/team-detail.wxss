/* pages/team-detail/team-detail.wxss */
.team-detail-content {
  padding: 32rpx 32rpx 80rpx;
}

/* 头部卡 */
.team-header-card {
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.header-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
}

.team-meta {
  flex: 1;
  min-width: 0;
}

.team-name {
  display: block;
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.team-desc {
  display: block;
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
}

.stat-num {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-primary);
}

.stat-label {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.stat-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-gray-300);
}

/* Tab */
.tab-bar {
  display: flex;
  flex-direction: row;
  margin-top: 32rpx;
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--border-light);
  border-bottom: none;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--text-tertiary);
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: var(--color-brand);
  border-bottom-color: var(--color-brand);
}

/* 成员列表 */
.members-list {
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--border-light);
  border-top: none;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  overflow: hidden;
}

.member-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.member-row:last-child {
  border-bottom: none;
}

.member-name {
  flex: 1;
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--text-primary);
}

.member-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.member-badge.creator {
  background: var(--color-brand-lightest);
  color: var(--color-brand-dark);
}

.member-badge.member {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

/* 待办列表 */
.todos-pane {
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--border-light);
  border-top: none;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  padding: 8rpx 32rpx 24rpx;
}

.todo-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 8rpx;
}

/* 邀请按钮（即将上线） */
/* 邀请按钮：品牌渐变主按钮（与登录/提交按钮同一视觉语言） */
button.invite-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 1;
  background: linear-gradient(180deg, var(--color-brand-light) 0%, var(--color-brand) 100%);
  color: #ffffff;
  border: none;
  border-radius: var(--radius-lg);
  font-size: var(--fs-md);
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx var(--brand-tint-strong), inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
}

button.invite-btn::after {
  border: none;
}

.invite-btn:active {
  opacity: 0.85;
}

.invite-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ---- 0.8 新增：周报 / 成员管理 / 动态流 ---- */
.report-btn {
  margin-left: auto;
  font-size: var(--fs-sm);
  color: var(--color-brand);
  background-color: var(--brand-tint);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
}

.member-badge.admin {
  background-color: var(--info-tint);
  color: var(--state-info);
}

.remove-member-btn {
  font-size: var(--fs-xs);
  color: var(--state-error);
  padding: 8rpx 20rpx;
}

.danger-actions {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  padding: 32rpx 0 8rpx;
}

.ghost-link {
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
  padding: 12rpx 24rpx;
}

.ghost-link.danger,
.event-link {
  font-size: var(--fs-xs);
}

.ghost-link.danger {
  color: var(--state-error);
}

/* 动态流 */
.events-pane {
  padding-top: 24rpx;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.event-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background-color: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--card-shadow), inset 0 1rpx 0 var(--surface-edge);
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-line {
  line-height: 1.5;
}

.event-actor {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.event-action {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.event-complete .event-action { color: var(--color-brand); }
.event-nudge { color: var(--state-warning) !important; }

.event-time {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
}

.event-link {
  color: var(--color-brand);
  padding: 4rpx 8rpx;
}

/* ---- 0.15 离屏分享封面画布 ---- */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
}

/* ---- 0.15.1 治理操作 ---- */
.gov-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gov-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--fs-base);
  font-weight: 600;
}

.gov-btn.warn {
  background: var(--warning-tint);
  color: var(--state-warning);
  border: 1rpx solid var(--state-warning);
}

.gov-btn.danger {
  background: var(--error-tint);
  color: var(--state-error);
  border: 1rpx solid var(--state-error);
}

.gov-btn.plain {
  background: var(--surface);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-light);
}
