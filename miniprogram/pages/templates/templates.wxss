/* pages/templates/templates.wxss */
.tpl-content {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 模板卡片 */
.tpl-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--card-shadow), inset 0 1rpx 0 var(--surface-edge);
  border-radius: var(--radius-lg);
  padding: 28rpx;
}

.tpl-card.active {
  border-color: var(--color-brand);
}

.tpl-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tpl-icon-char {
  color: #ffffff;
  font-size: var(--fs-xl);
  font-weight: 700;
}

.tpl-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tpl-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-primary);
}

.tpl-desc {
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.tpl-meta {
  display: flex;
  gap: 12rpx;
}

.tpl-tag {
  font-size: 18rpx;
  color: var(--text-tertiary);
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-full);
  padding: 4rpx 14rpx;
}

.tpl-tag.mode {
  color: var(--color-brand-dark);
  background-color: var(--brand-tint);
}

.tpl-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  transition: transform 0.2s;
}

.tpl-arrow.open {
  transform: rotate(90deg);
}

.card-pressed {
  opacity: 0.72;
}

/* 配置面板 */
.config-card {
  background-color: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--color-brand);
  box-shadow: var(--card-shadow);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cfg-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--text-primary);
}

.cfg-label {
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
}

.team-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.team-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-tertiary);
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.team-chip.active {
  background-color: var(--brand-tint);
  color: var(--color-brand-dark);
  font-weight: 600;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

.date-text {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.date-hint {
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
}

.member-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.member-chip {
  padding: 10rpx 26rpx;
  border-radius: var(--radius-full);
  background-color: var(--bg-tertiary);
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.member-chip.selected {
  background-color: var(--brand-tint);
  color: var(--color-brand-dark);
  border-color: var(--color-brand);
  font-weight: 600;
}

/* 任务预览 */
.task-preview {
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 8rpx 20rpx;
}

.tp-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.tp-row:last-child {
  border-bottom: none;
}

.tp-date {
  font-size: var(--fs-xs);
  color: var(--color-brand-dark);
  font-weight: 600;
  width: 160rpx;
}

.tp-title {
  flex: 1;
  font-size: var(--fs-sm);
  color: var(--text-primary);
}

.generate-btn {
  margin-top: 12rpx;
  background: linear-gradient(180deg, var(--color-brand-light) 0%, var(--color-brand) 100%);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  height: 92rpx;
  line-height: 92rpx;
  font-size: var(--fs-md);
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx var(--brand-tint-strong), inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
}

.generate-btn::after {
  border: none;
}

.generate-btn[disabled] {
  background-color: var(--color-gray-300);
  box-shadow: none;
}
