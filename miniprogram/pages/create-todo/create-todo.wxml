<!-- pages/create-todo/create-todo.wxml -->
<view class="page-container {{themeClass}}">
  <nav-bar title="创建待办" show-back="{{true}}"></nav-bar>

  <view class="form-content">
    <!-- 表单卡 -->
    <view class="form-card">
      <!-- 基本信息 -->
      <view class="form-section">
        <view class="form-group">
          <text class="form-label">待办标题</text>
          <input
            class="form-input"
            type="text"
            placeholder="请输入待办标题"
            placeholder-class="form-placeholder"
            value="{{title}}"
            bindinput="onTitleInput"
            maxlength="50"
          />
        </view>
        <view class="form-group">
          <text class="form-label">待办描述</text>
          <textarea
            class="form-textarea"
            placeholder="添加详细描述..."
            placeholder-class="form-placeholder"
            value="{{description}}"
            bindinput="onDescInput"
            maxlength="200"
            auto-height
          />
        </view>
      </view>

      <view class="divider"></view>

      <!-- 截止日期 + 时间 -->
      <view class="form-section">
        <text class="form-label">截止时间</text>
        <picker mode="date" value="{{dueDate}}" start="{{today}}" bindchange="onDateChange">
          <view class="date-row">
            <view class="date-left">
              <image class="calendar-icon" src="{{calendarIcon}}" />
              <text class="date-text {{dueDate ? '' : 'placeholder'}}">{{dueDate ? dueDate : '请选择截止日期'}}</text>
            </view>
            <image class="chevron-icon" src="{{chevronIcon}}" />
          </view>
        </picker>
        <picker mode="time" value="{{dueTime}}" disabled="{{!dueDate}}" bindchange="onTimeChange">
          <view class="date-row time-row {{dueDate ? '' : 'disabled'}}">
            <view class="date-left">
              <image class="calendar-icon" src="{{clockIcon}}" />
              <text class="date-text {{dueTime ? '' : 'placeholder'}}">{{dueDate ? (dueTime ? dueTime : '选择提醒时间（可选）') : '先选择日期'}}</text>
            </view>
            <view class="time-right" wx:if="{{dueTime}}" catchtap="onClearTime">清除</view>
          </view>
        </picker>
      </view>

      <view class="divider"></view>

      <!-- 优先级 -->
      <view class="form-section">
        <text class="form-label">优先级</text>
        <view class="priority-chips">
          <view
            class="priority-chip {{priority === item.key ? 'active' : ''}} priority-{{item.key}}"
            wx:for="{{priorityDefs}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="selectPriority"
          >
            <view wx:if="{{item.key === 'urgent'}}" class="priority-dot"></view>
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="divider"></view>

      <!-- 关联团队 -->
      <view class="form-section">
        <text class="form-label">关联团队</text>
        <block wx:if="{{locked}}">
          <view class="lock-team-row">
            <text class="lock-team-name">{{lockTeamName}}</text>
            <text class="lock-tag">不可更改</text>
          </view>
        </block>
        <block wx:elif="{{teams.length > 0}}">
          <view class="team-chips">
            <view
              class="team-chip {{selectedTeamId === item.id ? 'active' : ''}}"
              wx:for="{{teams}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="selectTeam"
            >{{item.name}}</view>
          </view>
        </block>
        <block wx:else>
          <view class="no-team-guide">
            <text class="ntg-text">还没有团队，待办需要挂在团队下</text>
            <view class="ntg-btn" hover-class="card-pressed" bindtap="goCreateTeam">去创建团队</view>
          </view>
        </block>
      </view>

      <!-- 指派方式 + 成员/名额（编辑模式下锁定隐藏） -->
      <block wx:if="{{!locked}}">
        <view class="divider"></view>

        <!-- 指派方式 -->
        <view class="form-section">
          <text class="form-label">指派方式</text>
          <view class="mode-seg">
            <view
              class="mode-item {{mode === item.key ? 'active' : ''}}"
              wx:for="{{modeDefs}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="selectMode"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
          <text class="mode-hint">{{mode === 'claim' ? '发布后团队成员可自行认领名额' : '直接指派给指定成员'}}</text>
        </view>

        <view class="divider"></view>

        <!-- 成员 / 名额 -->
        <view class="form-section" wx:if="{{mode === 'assign'}}">
          <text class="form-label">指派成员</text>
          <!-- 已选成员 -->
          <view class="selected-members" wx:if="{{selectedMembers.length > 0}}">
            <view class="selected-member" wx:for="{{selectedMembers}}" wx:key="id">
              <view class="member-avatar-sm" style="background-color: {{item.avatarColor}};">{{item.avatarChar}}</view>
              <text class="member-name-sm">{{item.name}}</text>
              <view class="remove-btn" data-id="{{item.id}}" catchtap="removeMember">×</view>
            </view>
          </view>
          <!-- 可选成员 -->
          <view class="member-pool" wx:if="{{members.length > 0}}">
            <view
              class="member-chip"
              wx:for="{{members}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="toggleMember"
            >
              <view class="member-avatar-xs" style="background-color: {{item.avatarColor}};">{{item.avatarChar}}</view>
              <text class="member-name-xs">{{item.name}}</text>
            </view>
          </view>
          <view wx:else class="empty-members">该团队暂无可指派成员</view>
        </view>

        <!-- 认领名额 -->
        <view class="form-section" wx:if="{{mode === 'claim'}}">
          <text class="form-label">认领名额</text>
          <view class="slot-stepper">
            <view class="step-btn {{slotCount <= 1 ? 'disabled' : ''}}" bindtap="onSlotMinus">−</view>
            <text class="slot-num">{{slotCount}} 人</text>
            <view class="step-btn {{slotCount >= 10 ? 'disabled' : ''}}" bindtap="onSlotPlus">＋</view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="divider"></view>
        <view class="edit-lock-hint">团队与成员指派创建后不可修改，如需调整请删除后重新创建</view>
      </block>

      <view class="divider"></view>

      <!-- 重复规则 -->
      <view class="form-section">
        <text class="form-label">重复规则</text>
        <view class="repeat-chips">
          <view
            class="repeat-chip {{repeat === item.key ? 'active' : ''}}"
            wx:for="{{repeatDefs}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="selectRepeat"
          >{{item.label}}</view>
        </view>
        <text class="mode-hint" wx:if="{{repeat !== 'none'}}">完成后自动创建下一期任务</text>
      </view>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="submit-bar">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交待办'}}</button>
    <view class="safe-bottom"></view>
  </view>
</view>
