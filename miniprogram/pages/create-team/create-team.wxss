/* pages/create-team/create-team.wxss */
.form-content {
  padding: 24rpx 32rpx;
}

.form-card {
  background-color: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);;
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.form-label {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.form-input {
  margin-top: 20rpx;
  height: 88rpx;
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: var(--fs-md);
  color: var(--text-primary);
}

.form-textarea {
  margin-top: 20rpx;
  width: 100%;
  min-height: 120rpx;
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--fs-sm);
  color: var(--text-primary);
}

.form-placeholder {
  color: var(--text-tertiary);
}

.divider {
  height: 1rpx;
  background-color: var(--border-light);
  margin: 32rpx 0;
}

/* 色板 */
.color-row {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

.color-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.color-dot.active {
  border-color: var(--text-primary);
  transform: scale(1.05);
}

.color-check {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 实时预览 */
.preview-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: 24rpx;
}

.preview-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  color: #ffffff;
  font-size: var(--fs-xl);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.preview-name {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-primary);
}

.preview-desc {
  font-size: var(--fs-xs);
  color: var(--text-tertiary);
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--nav-bg);
}

.submit-btn {
  background-color: var(--color-brand);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  font-size: var(--fs-md);
  font-weight: 600;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background-color: var(--color-gray-300);
}

/* ---- 0.16 建团成功情境态 ---- */
.success-view {
  padding: 120rpx 64rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-brand);
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx var(--brand-tint-strong);
}

.success-title {
  margin-top: 48rpx;
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.success-desc {
  margin-top: 16rpx;
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
}

.invite-now-btn {
  margin-top: 80rpx;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
  line-height: 1;
  background: linear-gradient(180deg, var(--color-brand-light) 0%, var(--color-brand) 100%);
  color: #ffffff;
  border-radius: var(--radius-full);
  font-size: var(--fs-md);
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx var(--brand-tint-strong), inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
}

.invite-now-btn::after {
  border: none;
}

.invite-share-icon {
  width: 34rpx;
  height: 34rpx;
}

.later-link {
  margin-top: 32rpx;
  font-size: var(--fs-sm);
  color: var(--text-tertiary);
  padding: 16rpx;
}
