<!-- pages/create-team/create-team.wxml -->
<view class="page-container {{themeClass}}">
  <nav-bar title="{{createdTeam ? '团队已创建' : '创建团队'}}" show-back="{{!createdTeam}}"></nav-bar>

  <!-- 成功态：情境化邀请（全产品最强邀请时机） -->
  <view wx:if="{{createdTeam}}" class="success-view">
    <view class="success-icon">✓</view>
    <text class="success-title">「{{createdTeam.name}}」建好了</text>
    <text class="success-desc">一个人做待办没意思，拉上伙伴一起</text>
    <button class="invite-now-btn" open-type="share" hover-class="card-pressed">
      <image class="invite-share-icon" src="{{shareIcon}}" />
      <text>立即邀请成员</text>
    </button>
    <view class="later-link" bindtap="goBack">稍后再说</view>
  </view>

  <!-- 表单态 -->
  <view wx:else class="form-content">
    <view class="form-card">
      <!-- 团队名称 -->
      <view class="form-section">
        <text class="form-label">团队名称</text>
        <input
          class="form-input"
          type="text"
          placeholder="如：产品设计组"
          placeholder-class="form-placeholder"
          value="{{name}}"
          bindinput="onNameInput"
          maxlength="20"
        />
      </view>

      <view class="divider"></view>

      <!-- 团队描述 -->
      <view class="form-section">
        <text class="form-label">团队简介（可选）</text>
        <textarea
          class="form-textarea"
          placeholder="一句话介绍这个团队做什么..."
          placeholder-class="form-placeholder"
          value="{{description}}"
          bindinput="onDescInput"
          maxlength="50"
          auto-height
        />
      </view>

      <view class="divider"></view>

      <!-- 头像颜色 -->
      <view class="form-section">
        <text class="form-label">团队标识色</text>
        <view class="color-row">
          <view
            wx:for="{{palette}}"
            wx:key="*this"
            class="color-dot {{colorIndex === index ? 'active' : ''}}"
            style="background-color: {{item}};"
            data-index="{{index}}"
            bindtap="selectColor"
          >
            <text wx:if="{{colorIndex === index}}" class="color-check">✓</text>
          </view>
        </view>
      </view>

      <!-- 预览 -->
      <view class="preview-row" wx:if="{{name}}">
        <view class="preview-avatar" style="background-color: {{palette[colorIndex]}};">{{name[0]}}</view>
        <view class="preview-meta">
          <text class="preview-name">{{name}}</text>
          <text class="preview-desc">{{description || '创建后邀请成员加入'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="submit-bar" wx:if="{{!createdTeam}}">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '创建中...' : '创建团队'}}</button>
    <view class="safe-bottom"></view>
  </view>
</view>
