/* app.wxss 全局样式 + 设计令牌 */

page {
  /* 品牌色 */
  --color-brand: #10b981;
  --color-brand-light: #34d399;
  --color-brand-lightest: #d1fae5;
  --color-brand-dark: #059669;
  --color-brand-darker: #047857;

  /* 状态色 */
  --state-success: #10b981;
  --state-warning: #f59e0b;
  --state-error: #ef4444;
  --state-info: #3b82f6;

  /* 灰阶 */
  --color-gray-100: #f3f4f6;
  --color-gray-200: #e5e7eb;
  --color-gray-300: #d1d5db;
  --color-gray-400: #9ca3af;

  /* 背景 */
  --bg-primary: #ffffff;
  --bg-secondary: #f9fafb;
  --bg-tertiary: #f3f4f6;

  /* 文本 */
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-tertiary: #94a3b8;
  --text-inverse: #ffffff;

  /* 边框 */
  --border-light: #e5e7eb;
  --border-default: #d1d5db;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 4rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.05);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.10);
  --shadow-elevated: 0 12rpx 32rpx rgba(0,0,0,0.16);

  /* 间距令牌（4 的倍数体系） */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 字号令牌 */
  --fs-xs: 22rpx;
  --fs-sm: 26rpx;
  --fs-base: 30rpx;
  --fs-md: 32rpx;
  --fs-lg: 36rpx;
  --fs-xl: 40rpx;
  --fs-2xl: 48rpx;

  /* 内容区底部留白：tabbar 高度(100rpx) + 安全区 */
  --tabbar-height: 100rpx;

  /* 导航栏背景（带半透明 + 模糊） */
  --nav-bg: rgba(255, 255, 255, 0.95);

  /* 品牌淡色底（换肤跟随令牌） */
  --brand-tint: rgba(16, 185, 129, 0.10);
  --brand-tint-strong: rgba(16, 185, 129, 0.16);

  /* 状态色淡色底 */
  --warning-tint: rgba(245, 158, 11, 0.10);
  --error-tint: rgba(239, 68, 68, 0.10);
  --info-tint: rgba(59, 130, 246, 0.12);

  /* 表面材质令牌：经典=实色；液态玻璃(style-glass)下为半透明+模糊+高光边 */
  --surface: #ffffff;
  --surface-2: #ffffff;
  --surface-blur: none;
  --surface-edge: rgba(255, 255, 255, 0);
  --card-shadow: none;

  background-color: var(--bg-secondary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--fs-base);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 暗色模式：在根容器加 .theme-dark 类即可让所有 CSS 变量级联覆盖 */
.theme-dark {
  --color-brand: #34d399;
  --color-brand-light: #6ee7b7;
  --color-brand-lightest: #064e3b;
  --color-brand-dark: #34d399;
  --color-brand-darker: #6ee7b7;

  --color-gray-100: #1e293b;
  --color-gray-200: #334155;
  --color-gray-300: #475569;
  --color-gray-400: #64748b;

  --bg-primary: #1e293b;
  --bg-secondary: #0f172a;
  --bg-tertiary: #334155;

  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-tertiary: #64748b;
  --text-inverse: #0f172a;

  --border-light: #334155;
  --border-default: #475569;

  --shadow-sm: 0 2rpx 4rpx rgba(0,0,0,0.30);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.35);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.45);
  --shadow-elevated: 0 12rpx 32rpx rgba(0,0,0,0.50);

  --nav-bg: rgba(15, 23, 42, 0.92);

  --brand-tint: rgba(52, 211, 153, 0.14);
  --brand-tint-strong: rgba(52, 211, 153, 0.20);
  --warning-tint: rgba(245, 158, 11, 0.14);
  --error-tint: rgba(239, 68, 68, 0.14);
  --info-tint: rgba(96, 165, 250, 0.16);

  --surface: #1e293b;
  --surface-2: #1e293b;
}

/* ============ 界面风格：液态玻璃（iOS 风格） ============ */
/* 卡片/导航/TabBar 换为半透明毛玻璃材质；颜色皮肤(skin-*)仍独立叠加 */
.style-glass {
  --surface: rgba(255, 255, 255, 0.58);
  --surface-2: rgba(255, 255, 255, 0.40);
  --surface-blur: blur(40rpx);
  --surface-edge: rgba(255, 255, 255, 0.50);
  --nav-bg: rgba(255, 255, 255, 0.55);
  --shadow-sm: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(15, 23, 42, 0.10);
  --shadow-lg: 0 16rpx 40rpx rgba(15, 23, 42, 0.15);
  --card-shadow: var(--shadow-md);
}

.theme-dark.style-glass {
  --surface: rgba(30, 41, 59, 0.52);
  --surface-2: rgba(51, 65, 85, 0.38);
  --surface-edge: rgba(255, 255, 255, 0.10);
  --nav-bg: rgba(15, 23, 42, 0.55);
}

/* ---- 环境光背景：页面顶部铺品牌色/信息色柔光，让毛玻璃「有东西可透」 ---- */
.page-container.style-glass,
.login-page.style-glass {
  position: relative;
  z-index: 0;
}

.page-container.style-glass::before,
.login-page.style-glass::before {
  content: '';
  position: fixed;
  left: -20%;
  right: -20%;
  top: -14vh;
  height: 76vh;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(52% 40% at 22% 16%, var(--brand-tint-strong) 0%, transparent 68%),
    radial-gradient(46% 36% at 84% 4%, var(--info-tint) 0%, transparent 62%),
    radial-gradient(38% 30% at 58% 42%, var(--warning-tint) 0%, transparent 64%);
}

/* ---- 悬浮分层：卡片浮起、层次分明 ---- */
.style-glass .greeting-card,
.style-glass .form-card,
.style-glass .info-card,
.style-glass .progress-card,
.style-glass .members-card,
.style-glass .comments-card,
.style-glass .team-header-card,
.style-glass .profile-card,
.style-glass .settings-group,
.style-glass .overview-card,
.style-glass .chart-card,
.style-glass .member-card,
.style-glass .notif-item,
.style-glass .event-item,
.style-glass .preview-row {
  box-shadow: var(--card-shadow), inset 0 1rpx 0 var(--surface-edge);
}

/* 胶囊筛选器本体也玻璃化，选中白色药丸浮在其上 */
.style-glass .range-tabs {
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border: 1rpx solid var(--surface-edge);
  box-shadow: var(--shadow-sm);
}

.style-glass .stat-card,
.style-glass .search-wrap {
  border-color: rgba(255, 255, 255, 0.35);
  box-shadow: var(--shadow-sm);
}

/* ---- 主按钮：品牌渐变糖果质感 + 光晕投影 ---- */
.style-glass .submit-btn,
.style-glass .action-btn.btn-do,
.style-glass .btn-primary {
  background: linear-gradient(180deg, var(--color-brand-light) 0%, var(--color-brand) 100%);
  box-shadow:
    0 10rpx 28rpx var(--brand-tint-strong),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
}

.style-glass .submit-btn[disabled],
.style-glass .btn-primary[disabled] {
  background: var(--color-gray-300);
  box-shadow: none;
}

/* FAB 光晕加强 */
.style-glass .fab {
  box-shadow:
    0 12rpx 32rpx var(--brand-tint-strong),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

/* ============ 换肤：品牌色族覆盖（默认翡翠绿无需类名） ============ */
.skin-ocean {
  --color-brand: #3b82f6;
  --color-brand-light: #60a5fa;
  --color-brand-lightest: #dbeafe;
  --color-brand-dark: #2563eb;
  --color-brand-darker: #1d4ed8;
  --brand-tint: rgba(59, 130, 246, 0.10);
  --brand-tint-strong: rgba(59, 130, 246, 0.16);
}

.theme-dark.skin-ocean {
  --color-brand: #60a5fa;
  --color-brand-light: #93c5fd;
  --color-brand-lightest: #1e3a8a;
  --color-brand-dark: #60a5fa;
  --color-brand-darker: #93c5fd;
  --brand-tint: rgba(96, 165, 250, 0.14);
  --brand-tint-strong: rgba(96, 165, 250, 0.20);
}

.skin-sunset {
  --color-brand: #f97316;
  --color-brand-light: #fb923c;
  --color-brand-lightest: #ffedd5;
  --color-brand-dark: #ea580c;
  --color-brand-darker: #c2410c;
  --brand-tint: rgba(249, 115, 22, 0.10);
  --brand-tint-strong: rgba(249, 115, 22, 0.16);
}

.theme-dark.skin-sunset {
  --color-brand: #fb923c;
  --color-brand-light: #fdba74;
  --color-brand-lightest: #7c2d12;
  --color-brand-dark: #fb923c;
  --color-brand-darker: #fdba74;
  --brand-tint: rgba(251, 146, 60, 0.14);
  --brand-tint-strong: rgba(251, 146, 60, 0.20);
}

view, text, image, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

/* 通用容器 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-secondary);
}

/* 卡片基础样式 */
.card {
  background: var(--surface);
  backdrop-filter: var(--surface-blur);
  -webkit-backdrop-filter: var(--surface-blur);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
}

/* 主按钮 */
.btn-primary {
  background: var(--color-brand);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: var(--fs-md);
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.btn-primary[disabled] {
  background: var(--color-gray-300);
  color: var(--text-inverse);
  opacity: 0.7;
}

/* 次按钮（描边） */
.btn-ghost {
  background: var(--bg-primary);
  color: var(--color-brand-dark);
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-md);
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: var(--fs-sm);
  font-weight: 500;
}

.btn-ghost::after {
  border: none;
}

/* flex 工具类 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 文本工具 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-brand { color: var(--color-brand); }
.text-warning { color: var(--state-warning); }
.text-error { color: var(--state-error); }
.text-success { color: var(--state-success); }

.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 安全区底部填充 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用按压反馈 */
.tap-feedback:active {
  background-color: var(--bg-secondary);
}

/* 登录按钮同样获得玻璃糖果质感 */
.style-glass .login-btn {
  background: linear-gradient(180deg, var(--color-brand-light) 0%, var(--color-brand) 100%);
  box-shadow:
    0 10rpx 28rpx var(--brand-tint-strong),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.40);
}
